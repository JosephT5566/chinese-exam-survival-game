{
  "name": "chinese-exam-survival-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:rules": "firebase emulators:exec --project demo-chinese-exam --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-chinese-exam --only auth,firestore",
    "rules:check": "node scripts/generate-leaderboard-validation.mjs --check",
    "check": "npm run rules:check && npm run typecheck && npm test && npm run build",
    "test:integration": "firebase emulators:exec --project demo-chinese-exam --only auth,firestore \"vitest run --config vitest.integration.config.ts\"",
    "test:browser": "firebase emulators:exec --project demo-chinese-exam --only auth,firestore \"playwright test\""
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "firebase-tools": "^15.36.0",
    "happy-dom": "^21.0.4",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
