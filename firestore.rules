rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function anonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function verifiedGoogle() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true && request.auth.token.email is string;
    }
    function teacherEmail() { return request.auth.token.email.lower(); }
    function teacher() {
      return verifiedGoogle()
        && get(/databases/$(database)/documents/teacherEmails/$(teacherEmail())).data.authorized == true;
    }
    function owner(roomId) {
      return teacher() && get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid;
    }
    function member(roomId) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/players/$(request.auth.uid));
    }
    function privateReader(roomId, uid) {
      return (signedIn() && request.auth.uid == uid && member(roomId)) || owner(roomId);
    }
    function exact(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }
    function text(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function nickname(value) { return text(value, 2, 12); }
    function code(value) { return value is string && value.matches('^[A-Z0-9]{6}$'); }
    function score(value) { return value is int && value >= 0 && value <= 96000; }
    function clamp(value) { return value < 0 ? 0 : value; }
    function v2(r) { return r.get('rulesVersion', 0) == 2; }
    function live(r) {
      return v2(r) && r.status == 'running' && r.runningSince is timestamp
        && request.time < r.runningSince + duration.value(r.remainingMs, 'ms');
    }
    function playing(roomId, uid) {
      return anonymous() && request.auth.uid == uid && member(roomId)
        && live(get(/databases/$(database)/documents/rooms/$(roomId)).data);
    }
    function roomShape(r) {
      return exact(r, ['code', 'ownerUid', 'questionSetVersion', 'status', 'createdAt', 'updatedAt', 'startedAt', 'endedAt',
          'rulesVersion', 'durationMinutes', 'remainingMs', 'runningSince', 'pausedAt', 'playerCount'])
        && v2(r) && code(r.code) && text(r.ownerUid, 1, 128) && text(r.questionSetVersion, 1, 80)
        && r.status in ['lobby', 'running', 'paused', 'ended', 'archived']
        && r.createdAt is timestamp && r.updatedAt is timestamp
        && (r.startedAt == null || r.startedAt is timestamp) && (r.endedAt == null || r.endedAt is timestamp)
        && r.durationMinutes is int && r.durationMinutes >= 1 && r.durationMinutes <= 60
        && r.remainingMs is int && r.remainingMs >= 0 && r.remainingMs <= 3600000
        && (r.runningSince == null || r.runningSince is timestamp)
        && (r.pausedAt == null || r.pausedAt is timestamp)
        && r.playerCount is int && r.playerCount >= 0 && r.playerCount <= 30;
    }
    function elapsedMs(start, end) {
      let d = end - start;
      return int(d.seconds() * 1000 + d.nanos() / 1000000);
    }
    function roomTransition() {
      let old = resource.data;
      let next = request.resource.data;
      let start = old.status == 'lobby' && next.status == 'running';
      let resume = old.status == 'paused' && next.status == 'running';
      let pause = old.status == 'running' && next.status == 'paused';
      let end = old.status in ['lobby', 'running', 'paused'] && next.status == 'ended';
      let archive = old.status == 'ended' && next.status == 'archived';
      let configure = old.status == 'lobby' && next.status == 'lobby';
      return v2(old) && roomShape(next) && next.updatedAt == request.time
        && next.diff(old).affectedKeys().hasOnly(['status', 'updatedAt', 'startedAt', 'endedAt', 'durationMinutes', 'remainingMs', 'runningSince', 'pausedAt'])
        && next.startedAt == (start ? request.time : old.startedAt)
        && next.endedAt == (end ? request.time : old.endedAt)
        && (configure || next.durationMinutes == old.durationMinutes)
        && ((configure && next.runningSince == null && next.pausedAt == null && next.remainingMs == next.durationMinutes * 60000)
          || (start && old.remainingMs > 0 && next.remainingMs == old.remainingMs && next.runningSince == request.time && next.pausedAt == null)
          || (resume && next.remainingMs == old.remainingMs - elapsedMs(old.runningSince, old.pausedAt)
            && next.remainingMs > 0 && next.runningSince == request.time && next.pausedAt == null)
          || (pause && live(old) && next.runningSince == old.runningSince && next.pausedAt == request.time
            && next.remainingMs == old.remainingMs)
          || (end && next.runningSince == null && next.pausedAt == null && next.remainingMs == 0)
          || (archive && next.runningSince == null && next.pausedAt == null && next.remainingMs == old.remainingMs));
    }
    function playerShape(p) {
      return exact(p, ['nickname', 'joinedAt', 'questionOrder', 'choiceOrders', 'completedCount', 'revision', 'lastOperation', 'finishedAt', 'cooldownStartedAt', 'pendingId'])
        && nickname(p.nickname) && p.joinedAt is timestamp
        && p.questionOrder is list && p.questionOrder.size() == 40 && p.questionOrder.toSet().size() == 40
        && p.choiceOrders is map && p.choiceOrders.keys().toSet() == p.questionOrder.toSet()
        && p.completedCount is int && p.completedCount >= 0 && p.completedCount <= 40
        && p.revision is int && p.revision >= 0 && p.revision <= 120
        && (p.finishedAt == null || p.finishedAt is timestamp)
        && (p.cooldownStartedAt == null || p.cooldownStartedAt is timestamp)
        && (p.pendingId == null || text(p.pendingId, 1, 128));
    }
    function scoreShape(s) {
      return exact(s, ['nickname', 'score', 'lastOperation']) && nickname(s.nickname) && score(s.score);
    }
    function initialPlayer(p) {
      return playerShape(p) && p.joinedAt == request.time && p.completedCount == 0 && p.revision == 0
        && p.lastOperation == null && p.finishedAt == null && p.cooldownStartedAt == null && p.pendingId == null;
    }
    function joining(roomId, uid) {
      let path = /databases/$(database)/documents/rooms/$(roomId);
      let r = get(path).data;
      let after = getAfter(path).data;
      let ppath = /databases/$(database)/documents/rooms/$(roomId)/players/$(uid);
      let spath = /databases/$(database)/documents/rooms/$(roomId)/scores/$(uid);
      let p = getAfter(ppath).data;
      let s = getAfter(spath).data;
      let index = get(/databases/$(database)/documents/roomCodes/$(r.code)).data;
      return anonymous() && request.auth.uid == uid && v2(r) && r.status == 'lobby' && r.playerCount < 30
        && index.roomId == roomId && index.ownerUid == r.ownerUid
        && !exists(ppath) && !exists(spath) && initialPlayer(p)
        && scoreShape(s) && s.nickname == p.nickname && s.score == 0 && s.lastOperation == null
        && roomShape(after) && after.playerCount == r.playerCount + 1
        && after.diff(r).affectedKeys().hasOnly(['playerCount']);
    }
    function operation(p) {
      return p.lastOperation is map && exact(p.lastOperation, ['kind', 'id'])
        && p.lastOperation.kind in ['answer', 'open', 'claim', 'finish'] && text(p.lastOperation.id, 1, 128);
    }
    function validChoices(p, id) {
      let c = p.choiceOrders[id];
      return c is list && c.size() == 4 && c.toSet() == [0, 1, 2, 3].toSet()
        && c[0] is int && c[1] is int && c[2] is int && c[3] is int;
    }
    function answerShape(a) {
      return exact(a, ['ordinal', 'selectedChoice', 'isCorrect', 'explanationViewed', 'awardedPoints', 'answeredAt', 'explanationViewedAt', 'chest'])
        && a.ordinal is int && a.ordinal >= 1 && a.ordinal <= 40
        && a.selectedChoice is int && a.selectedChoice >= 0 && a.selectedChoice <= 3
        && a.isCorrect is bool && a.explanationViewed == false && a.awardedPoints == 0
        && a.answeredAt is timestamp && a.explanationViewedAt == null;
    }
    function newAnswer(a) { return answerShape(a) && a.answeredAt == request.time && a.chest == null; }
    function chestShape(c) {
      return c is map && exact(c, ['box', 'outcome', 'targetId', 'settled', 'delta', 'fallback'])
        && c.box is int && c.box >= 0 && c.box <= 2
        && c.outcome is map && exact(c.outcome, ['kind', 'amount'])
        && ((c.outcome.kind == 'gain' && c.outcome.amount in [20, 50, 80])
          || (c.outcome.kind == 'loss' && c.outcome.amount in [10, 20, 30])
          || (c.outcome.kind in ['steal', 'swap'] && c.outcome.amount == 0))
        && (c.targetId == null || text(c.targetId, 1, 128))
        && c.settled is bool && c.delta is int && c.fallback is bool;
    }
    function opened(old, next) {
      return old.isCorrect && old.chest == null
        && next.diff(old).affectedKeys().hasOnly(['chest']) && chestShape(next.chest)
        && next.chest.targetId == null && !next.chest.settled && next.chest.delta == 0 && !next.chest.fallback;
    }
    function settled(old, next) {
      return old.isCorrect && old.chest != null && !old.chest.settled
        && next.diff(old).affectedKeys().hasOnly(['chest'])
        && exact(next.chest, ['box', 'outcome', 'targetId', 'settled', 'delta', 'fallback'])
        && next.chest.delta is int && next.chest.settled == true
        && next.chest.box == old.chest.box && next.chest.outcome == old.chest.outcome;
    }
    function answerProgress(roomId, uid, old, next) {
      let id = next.lastOperation.id;
      let path = /databases/$(database)/documents/rooms/$(roomId)/players/$(uid)/answers/$(id);
      let a = getAfter(path).data;
      return old.pendingId == null && (old.cooldownStartedAt == null || request.time >= old.cooldownStartedAt + duration.value(3, 's'))
        && old.finishedAt == null && !exists(path) && newAnswer(a) && a.ordinal == old.completedCount + 1
        && old.questionOrder[a.ordinal - 1] == id && validChoices(old, id)
        && next.completedCount == a.ordinal && next.pendingId == (a.isCorrect ? id : null)
        && next.cooldownStartedAt == (a.isCorrect ? null : request.time) && next.finishedAt == null;
    }
    function chestProgress(roomId, uid, old, next) {
      let id = next.lastOperation.id;
      let path = /databases/$(database)/documents/rooms/$(roomId)/players/$(uid)/answers/$(id);
      let before = get(path).data;
      let after = getAfter(path).data;
      return old.pendingId == id && next.completedCount == old.completedCount && next.cooldownStartedAt == old.cooldownStartedAt
        && ((next.lastOperation.kind == 'open' && opened(before, after) && next.pendingId == id && next.finishedAt == old.finishedAt)
          || (next.lastOperation.kind == 'claim' && next.pendingId == null
            && next.finishedAt == (old.completedCount == 40 ? request.time : old.finishedAt)
            && claim(roomId, uid, id)));
    }
    function finishProgress(roomId, uid, old, next) {
      let id = next.lastOperation.id;
      let a = get(/databases/$(database)/documents/rooms/$(roomId)/players/$(uid)/answers/$(id)).data;
      return old.completedCount == 40 && old.pendingId == null && old.finishedAt == null
        && old.cooldownStartedAt is timestamp && request.time >= old.cooldownStartedAt + duration.value(3, 's')
        && old.questionOrder[39] == id && a.isCorrect == false
        && next.completedCount == old.completedCount && next.pendingId == null
        && next.cooldownStartedAt == old.cooldownStartedAt && next.finishedAt == request.time;
    }
    function progress(roomId, uid) {
      let old = resource.data;
      let next = request.resource.data;
      return playing(roomId, uid) && operation(next) && next.revision is int && next.revision <= 120 && next.revision == old.revision + 1
        && next.diff(old).affectedKeys().hasOnly(['completedCount', 'revision', 'lastOperation', 'finishedAt', 'cooldownStartedAt', 'pendingId'])
        && ((next.lastOperation.kind == 'answer' && answerProgress(roomId, uid, old, next))
          || (next.lastOperation.kind in ['open', 'claim'] && chestProgress(roomId, uid, old, next))
          || (next.lastOperation.kind == 'finish' && finishProgress(roomId, uid, old, next)));
    }
    // The player update validates every companion document; this witness requires that update in the same commit.
    function paired(roomId, uid, kind, id) {
      let path = /databases/$(database)/documents/rooms/$(roomId)/players/$(uid);
      let before = get(path).data;
      let after = getAfter(path).data;
      return anonymous() && request.auth.uid == uid && after.revision == before.revision + 1
        && after.lastOperation == {'kind': kind, 'id': id};
    }
    function scoreChanged(roomId, uid, actor, id, value) {
      let path = /databases/$(database)/documents/rooms/$(roomId)/scores/$(uid);
      let old = get(path).data;
      let next = getAfter(path).data;
      return scoreShape(next) && next.nickname == old.nickname && next.score == value
        && next.lastOperation == {'actor': actor, 'id': id};
    }
    function targetClaim(roomId, uid, id, c, own) {
      let target = c.targetId;
      let other = get(/databases/$(database)/documents/rooms/$(roomId)/scores/$(target)).data.score;
      let stolen = other < 100 ? other : 100;
      let ownAfter = c.outcome.kind == 'steal' ? own + stolen : other;
      let otherAfter = c.outcome.kind == 'steal' ? other - stolen : own;
      return target != uid && text(target, 1, 128) && !c.fallback
        && c.outcome.kind in ['steal', 'swap'] && c.delta == ownAfter - own
        && scoreChanged(roomId, uid, uid, id, ownAfter) && scoreChanged(roomId, target, uid, id, otherAfter);
    }
    function soloClaim(roomId, uid, id, c, own) {
      let fallback = c.outcome.kind in ['steal', 'swap'];
      let next = fallback ? own + 20 : (c.outcome.kind == 'gain' ? own + c.outcome.amount : clamp(own - c.outcome.amount));
      return c.targetId == null && c.fallback == fallback
        && (!fallback || get(/databases/$(database)/documents/rooms/$(roomId)).data.playerCount == 1)
        && c.delta == next - own && scoreChanged(roomId, uid, uid, id, next);
    }
    function claim(roomId, uid, id) {
      let path = /databases/$(database)/documents/rooms/$(roomId)/players/$(uid)/answers/$(id);
      let old = get(path).data;
      let next = getAfter(path).data;
      let own = get(/databases/$(database)/documents/rooms/$(roomId)/scores/$(uid)).data.score;
      return settled(old, next)
        && ((next.chest.targetId == null && soloClaim(roomId, uid, id, next.chest, own))
          || (next.chest.targetId != null && targetClaim(roomId, uid, id, next.chest, own)));
    }
    function scoreUpdate(roomId, uid) {
      let op = request.resource.data.lastOperation;
      let actor = request.auth.uid;
      let a = getAfter(/databases/$(database)/documents/rooms/$(roomId)/players/$(actor)/answers/$(op.id)).data;
      return anonymous() && op.actor == actor && paired(roomId, actor, 'claim', op.id)
        && (uid == actor || a.chest.targetId == uid);
    }
    function entry(e) {
      let s = e.score;
      // Both required property reads + size 2 exclude all extra fields.
      // Keep this bounded validator below the 1,000-expression request limit.
      return e.size() == 2 && e.nickname is string && s is int && s >= 0;
    }
    // BEGIN GENERATED LEADERBOARD VALIDATION
    function entriesValid(entries) {
      let count = entries.size();
      return entries is list && count <= 15
        && (count <= 0 || entry(entries[0]))
        && (count <= 1 || entry(entries[1]))
        && (count <= 2 || entry(entries[2]))
        && (count <= 3 || entry(entries[3]))
        && (count <= 4 || entry(entries[4]))
        && (count <= 5 || entry(entries[5]))
        && (count <= 6 || entry(entries[6]))
        && (count <= 7 || entry(entries[7]))
        && (count <= 8 || entry(entries[8]))
        && (count <= 9 || entry(entries[9]))
        && (count <= 10 || entry(entries[10]))
        && (count <= 11 || entry(entries[11]))
        && (count <= 12 || entry(entries[12]))
        && (count <= 13 || entry(entries[13]))
        && (count <= 14 || entry(entries[14]))
      ;
    }
    // END GENERATED LEADERBOARD VALIDATION

    match /teacherEmails/{email} {
      allow get: if verifiedGoogle() && teacherEmail() == email;
    }
    match /roomCodes/{joinCode} {
      allow get: if signedIn() && code(joinCode);
      allow create: if teacher() && code(joinCode)
        && exact(request.resource.data, ['roomId', 'ownerUid'])
        && text(request.resource.data.roomId, 1, 128) && request.resource.data.ownerUid == request.auth.uid
        && !exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.code == joinCode
        && getAfter(/databases/$(database)/documents/rooms/$(request.resource.data.roomId)).data.ownerUid == request.auth.uid;
    }
    match /rooms/{roomId} {
      allow get: if member(roomId) || owner(roomId)
        || (anonymous() && v2(resource.data) && resource.data.status == 'lobby');
      allow list: if teacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if teacher() && roomShape(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'lobby'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.startedAt == null && request.resource.data.endedAt == null
        && request.resource.data.runningSince == null && request.resource.data.pausedAt == null && request.resource.data.playerCount == 0
        && request.resource.data.remainingMs == request.resource.data.durationMinutes * 60000
        && getAfter(/databases/$(database)/documents/roomCodes/$(request.resource.data.code)).data == {'roomId': roomId, 'ownerUid': request.auth.uid};
      allow update: if (owner(roomId) && roomTransition()) || joining(roomId, request.auth.uid);

      match /players/{uid} {
        allow get, list: if privateReader(roomId, uid);
        allow create: if joining(roomId, uid);
        allow update: if progress(roomId, uid);
        match /answers/{questionId} {
          allow read: if privateReader(roomId, uid);
          allow create: if paired(roomId, uid, 'answer', questionId);
          allow update: if paired(roomId, uid, 'open', questionId) || paired(roomId, uid, 'claim', questionId);
        }
        match /events/{eventId} {
          allow read: if privateReader(roomId, uid);
        }
      }
      match /scores/{uid} {
        allow read: if member(roomId) || owner(roomId);
        allow create: if joining(roomId, uid);
        allow update: if scoreUpdate(roomId, uid);
      }
      match /public/{snapshotId} {
        function snapshotIdValid() { return snapshotId in ['leaderboard', 'leaderboard2']; }
        function peerUpdated() {
          let peer = snapshotId == 'leaderboard' ? 'leaderboard2' : 'leaderboard';
          return getAfter(/databases/$(database)/documents/rooms/$(roomId)/public/$(peer)).data.updatedAt == request.time;
        }
        allow get: if snapshotIdValid() && (member(roomId) || owner(roomId));
        allow create, update: if snapshotIdValid() && owner(roomId)
          && v2(get(/databases/$(database)/documents/rooms/$(roomId)).data)
          && exact(request.resource.data, ['updatedAt', 'entries'])
          && request.resource.data.updatedAt == request.time && entriesValid(request.resource.data.entries)
          && peerUpdated();
      }
    }
  }
}
